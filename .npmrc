# babel-jest 29 declares a peer dependency on @babel/core 7, while this project
# builds with Babel 8. The two work together fine — Jest transforms TypeScript
# through ts-jest, not babel-jest — but npm refuses the tree unless told that a
# mismatched peer is acceptable. Without this, `npm install` fails on a clean
# machine (including Vercel's build container) even though it succeeds locally.
legacy-peer-deps=true
